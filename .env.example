# Domain the bot's website is served on, Caddy requests a certificate for it
HOST=discorki.nl

RIOT_API_KEY=RGAPI-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
# See https://developer.riotgames.com/docs/lol#routing-values
RIOT_PLATFORM_ROUTING=euw1
RIOT_REGIONAL_ROUTING=europe

DISCORD_BOT_TOKEN=

# The database isn't exposed outside of the compose network. These are only
# applied when the database is created for the first time.
DB_PASSWORD=discorki
DB_ROOT_PASSWORD=discorki
